[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/itdevpaydiya-source/vizito-patient-web.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "dev"]
	remote = origin
	merge = refs/heads/dev
[branch "epic/pharmacy"]
	vscode-merge-base = origin/dev
	remote = origin
	merge = refs/heads/epic/pharmacy
